FROM localhost/bc250-rocm-build:10.2-ccache

# Keep PyTorch's pinned CMake and Python tools separate from the superbuild.
COPY pytorch-requirements-build.txt /tmp/pytorch-requirements/requirements-build.txt
COPY pytorch-requirements.txt /tmp/pytorch-requirements/requirements.txt
RUN python3 -m venv /opt/torch-venv \
    && /opt/torch-venv/bin/pip install --no-cache-dir \
        -r /tmp/pytorch-requirements/requirements.txt
ENV PATH="/opt/torch-venv/bin:${PATH}"
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*
# PyTorch's bundled third-party projects still require CMake 3 compatibility.
RUN mkdir -p /opt/bc250-tools \
    && ln -s /usr/local/therock-tools/bin/cmake /opt/bc250-tools/cmake
ENV PATH="/opt/bc250-tools:${PATH}"
