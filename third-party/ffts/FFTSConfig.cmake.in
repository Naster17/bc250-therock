get_filename_component(_FFTS_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(FFTS_INCLUDE_DIRS "${_FFTS_PREFIX}/include/ffts")
set(FFTS_INCLUDE_DIR "${FFTS_INCLUDE_DIRS}")
set(FFTS_LIBRARY "${_FFTS_PREFIX}/lib/@CMAKE_STATIC_LIBRARY_PREFIX@ffts@CMAKE_STATIC_LIBRARY_SUFFIX@")
set(FFTS_LIBRARIES "${FFTS_LIBRARY}")
if(NOT TARGET FFTS::FFTS)
  add_library(FFTS::FFTS STATIC IMPORTED)
  set_target_properties(FFTS::FFTS PROPERTIES
    IMPORTED_LOCATION "${FFTS_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${FFTS_INCLUDE_DIRS}"
    INTERFACE_LINK_LIBRARIES "m"
  )
endif()
unset(_FFTS_PREFIX)
