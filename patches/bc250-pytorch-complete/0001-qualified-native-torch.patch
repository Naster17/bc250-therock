+    dbias = g.sum(1).to(bias->scalar_type());
+  }
+  if (output_mask[3] && has_alpha) {
+    auto product = g.mul(at::mm(a, b));
+    dalpha = (alpha->numel() == 1 ? product.sum() : product.sum(1))
+                 .to(alpha->scalar_type()).view(alpha->sizes());
+  }
+  return {dp, db, dbias, dalpha};
+}
